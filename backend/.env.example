APP_NAME=Resume Job Matcher API
APP_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:5500
MAX_UPLOAD_MB=5
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_WARMUP_ON_STARTUP=true
LLM_ENABLED=true
LLM_PROVIDER=ollama
OLLAMA_MODE=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_API_KEY=
LLM_TIMEOUT_SECONDS=60

# For Ollama Cloud:
# OLLAMA_MODE=cloud
# OLLAMA_BASE_URL=https://ollama.com/api
# OLLAMA_API_KEY=your_ollama_api_key_here

# --- Production / Render (commented examples - set these in the Render dashboard) ---
# EMBEDDING_DEVICE=cpu
# LLM_ENABLED=true
# LLM_PROVIDER=ollama
# OLLAMA_MODE=cloud
# OLLAMA_BASE_URL=https://ollama.com/api
# OLLAMA_MODEL=ministral-3:3b
# OLLAMA_API_KEY=                # set in Render dashboard ONLY, never commit
# LLM_TIMEOUT_SECONDS=60
# Or to fully disable chat (rule-based fallback): LLM_ENABLED=false
